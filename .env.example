# Variables de entorno opcionales para Círculo (copia a .env si necesitas sobrescribir valores por defecto).
# Nunca incluyas secretos reales en archivos versionados.

# Enlaces públicos usados por el modo Analizador Web (compilación Vite servida en davidcevallos.me/circulo/app/)
VITE_LANDING_URL=https://www.davidcevallos.me/circulo/
VITE_PRO_URL=https://www.davidcevallos.me/circulo/#reservar
VITE_DOWNLOAD_URL=https://www.davidcevallos.me/circulo/descargar/
VITE_REPO_URL=https://github.com/DavidCevallos15/circulo-app

# Canal de comprobación de actualizaciones del ejecutor local (Python)
# Admite la API de GitHub Releases o un manifiesto JSON HTTPS propio (preparado para futuros planes por uso).
CIRCULO_UPDATE_URL=https://api.github.com/repos/DavidCevallos15/circulo-app/releases/latest
# Lista separada por comas de dominios HTTPS adicionales permitidos para manifiestos propios.
CIRCULO_UPDATE_ALLOWED_HOSTS=api.github.com,github.com,davidcevallos.me,www.davidcevallos.me

# Firma Authenticode opcional al generar Circulo.exe (packaging/build_windows.ps1)
# CIRCULO_SIGN_THUMBPRINT=
# CIRCULO_SIGN_PFX=
# CIRCULO_SIGN_PFX_PASSWORD=
# CIRCULO_TIMESTAMP_URL=http://timestamp.digicert.com
